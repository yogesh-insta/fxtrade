{
  "oanda": {
    "account_id": "YOUR_DEMO_ACCOUNT_ID",
    "token": "YOUR_API_TOKEN",
    "environment": "practice",
    "_comment_initial_capital": "Demo baseline for account P/L: seed + any demo deposits (virtual, not real money)",
    "initial_capital_aud": 100250,
    "initial_capital_note": "OANDA demo seed $100,000 + $250 deposit 2026-07-07 (game adjuster credit); virtual only"
  },
  "email": {
    "smtp_host": "smtp.gmail.com",
    "smtp_port": 587,
    "username": "your@gmail.com",
    "password": "gmail-app-password",
    "alert_to": "alwin.manware@gmail.com",
    "min_interval_minutes": 120
  },
  "notifications": {
    "enabled": true,
    "prefix": "[FXPulse]",
    "nse_prefix": "[NiftyPulse]",
    "afl_prefix": "[AFLPulse]",
    "fx_prefix": "[FXPulse]",
    "on_trade_entry": false,
    "on_trade_exit": false,
    "email_on_trade_only": true,
    "daily_summary_only": true,
    "_comment_daily_summary_only": "When true, suppress all bot emails except cron-driven daily/weekly summaries",
    "_comment_email_on_trade_only": "When true (default), only trade events email (orders, fills, opens/closes). Strategy/sentiment digests are logged only.",
    "entry_include_runners_up": 3,
    "daily_summary_utc": "20:30",
    "_comment_daily_summary_utc": "bot-daily-email cron time (UTC); same-day report after force_flat at 20:00",
    "weekly_summary_utc": "Fri 07:00"
  },
  "bots": {
    "_comment_enabled": "Per-bot systemd units: universe_scanner (:8081), fx_sentiment (:8082), btc_cfd (:8083)",
    "enabled": ["universe_scanner", "fx_sentiment", "btc_cfd"]
  },
  "strategy": {
    "enabled": true,
    "mode": "fx_sentiment",
    "cycle_minutes": 15,
    "poll_seconds": 10,
    "journal_dir": "logs/fx_sentiment",
    "db_path": "data/fx_sentiment/trades.db"
  },
  "scanner": {
    "phase": 1,
    "universe_mode": "preset",
    "universe_preset": "volatile_phase1",
    "watchlist": [],
    "scan_concurrency": 4,
    "opening_range_candles": 2,
    "opening_range_granularity": "M15",
    "poll_seconds": 5,
    "_comment_balance": "Use config + allocated slice so three bots each size from $5000, not full NAV",
    "account_balance_usd": 5000,
    "balance_source": "config",
    "risk_per_trade_pct": 1.0,
    "stop_loss_pips_fx": 8,
    "stop_loss_points_crypto": 150,
    "stop_loss_points_index": 20,
    "take_profit_rr": 1.5,
    "daily_loss_cap_pct": 3.0,
    "weekly_profit_target_pct": 0,
    "min_setup_score": 0.4,
    "min_range_spread_ratio": 2.0,
    "runtime_mode": "always_on",
    "journal_dir": "logs/universe_scanner",
    "db_path": "data/universe_scanner/trades.db",
    "asset_classes": {
      "FX": {"max_spread_pips": 4.0, "session_utc": "07:00-20:00"},
      "JPY": {"max_spread_pips": 4.0, "session_utc": "00:00-20:00"},
      "METAL": {"max_spread_pips": 100, "session_utc": "12:00-22:00"},
      "CRYPTO": {"instruments": ["BTC_USD"], "max_spread_usd": 120, "session_utc": "24/7"},
      "INDEX": {"max_spread_points": 3.0, "session_utc": "13:00-21:00"}
    },
    "_comment_force_flat": "Close before NY rollover spread widening (~20:45 UTC)",
    "force_flat_utc": {
      "FX": "20:00",
      "JPY": "20:00",
      "METAL": "20:00",
      "INDEX": "20:00"
    }
  },
  "risk": {
    "_comment_allocated": "Per-bot capital slice for fx_sentiment sizing and loss caps",
    "allocated_capital_usd": 5000,
    "risk_per_trade_pct_base": 1.0,
    "risk_per_trade_pct_high_conf": 1.0,
    "max_daily_loss_pct": 3.0,
    "max_weekly_loss_pct": 5.0,
    "max_trades_per_month": 0,
    "max_open_positions": 3,
    "max_spread_pips": 6.0,
    "halt_file": ".halt"
  },
  "state": {
    "file": "data/state.json"
  },
  "instruments": ["AUD_USD", "EUR_USD"],
  "finnhub": {
    "api_key": ""
  },
  "llm": {
    "provider": "groq",
    "base_url": "https://api.groq.com/openai/v1",
    "api_key": "",
    "model": "llama-3.3-70b-versatile"
  },
  "sentiment": {
    "interval_minutes": 15,
    "max_headlines": 25,
    "headline_max_age_hours": 48,
    "audit_dir": "logs/sentiment"
  },
  "range_mode": {
    "range_lookback_weeks": 8,
    "min_range_width_pips": 120,
    "min_boundary_touches": 1,
    "flat_ema_threshold_pct": 2.5,
    "pending_limits_enabled": true
  },
  "trend_mode": {
    "_comment_week52": "Smaller block zone for practice demo; default code is 100 pips",
    "week52_block_distance_pips": 0,
    "rsi_long_min": 35,
    "rsi_long_max": 70,
    "rsi_short_min": 30,
    "rsi_short_max": 65
  },
  "llm_gate": {
    "veto_confidence": 0.9,
    "full_size_confidence": 0.6,
    "sentiment_persistence_readings": 2
  },
  "stock_scan": {
    "_comment_rsi_max": "Upper RSI bound; default 45, set 50 to widen NiftyPulse filter",
    "concurrency": 4,
    "request_timeout_seconds": 15,
    "rate_limit_ms": 300,
    "overall_timeout_minutes": 10,
    "sentiment_candidates": 3,
    "rsi_max": 50
  },
  "afl": {
    "_comment_odds_api_key": "Required: free key from https://the-odds-api.com",
    "odds_api_key": "",
    "odds_api_base_url": "https://api.the-odds-api.com/v4",
    "odds_sport_key": "aussierules_afl",
    "odds_regions": "au",
    "odds_markets": "h2h,totals",
    "_comment_gemini_api_key": "Required for T-45 pregame scanner (afl-pulse-pregame); also needed if llm_analytics_enabled is true",
    "gemini_api_key": "",
    "gemini_model": "gemini-2.5-flash-lite",
    "_comment_llm_analytics_enabled": "Opt-in weekly Gemini grounded analytics on the Thursday round scan; defaults false",
    "llm_analytics_enabled": false,
    "llm_concurrency": 2,
    "_comment_pregame": "T-45 pregame poll: alert when kickoff is pregame_lead_minutes away (within pregame_poll_window_minutes)",
    "pregame_lead_minutes": 45,
    "pregame_poll_window_minutes": 5,
    "pregame_state_path": "data/afl/pregame-sent.json",
    "pregame_llm_required": true,
    "pregame_llm_retries": 2,
    "min_ev_threshold": 0.05,
    "concurrency": 4,
    "max_odds_age_minutes": 30,
    "alert_top_n": 5,
    "overall_timeout_minutes": 5,
    "predictor_type": "matrix",
    "model_path": "data/afl/model_coefficients.json",
    "totals_model_path": "data/afl/totals_coefficients.json",
    "onnx_model_path": "",
    "stats_dir": "data/afl",
    "injuries_file": "data/afl/injuries.json",
    "stats_refresh_on_run": true,
    "_comment_stats_season_year": "Squiggle season year; 0 uses the current calendar year",
    "stats_season_year": 0,
    "squiggle_user_agent": ""
  },
  "btc_cfd": {
    "instrument": "BTC_USD",
    "granularity": "M5",
    "_comment_candle_count": "Complete M5 bars required for EMA200 etc.; OANDA fetch adds +1 for the forming bar",
    "candle_count": 200,
    "journal_dir": "logs/btc_cfd",
    "db_path": "data/btc_cfd/trades.db",
    "allocated_capital_usd": 5000,
    "rsi_period": 14,
    "deviation_atr_multiple": 1.0,
    "sl_atr_multiple": 1.2,
    "target_rr": 1.2,
    "per_trade_risk_pct": 0.5,
    "max_daily_loss_pct": 2.5,
    "max_trades_per_day": 10,
    "max_spread_usd": 120,
    "max_slippage_pct": 0.25,
    "atr_spike_multiple": 3.0
  }
}
