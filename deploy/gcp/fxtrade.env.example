# Copy to /etc/fxtrade/fxtrade.env (install.sh does this on first run).
FXTRADE_HOME=/opt/fxtrade
FXTRADE_CREDENTIALS=/opt/fxtrade/.credentials
FXTRADE_HEALTH_ADDR=:8080
# Global dry-run (paper orders). Per-bot units can override via /etc/fxtrade/fxtrade@BOT.env:
#   FXTRADE_DRY_RUN=
# Uncomment for paper/testing without live orders:
# FXTRADE_DRY_RUN=--dry-run
