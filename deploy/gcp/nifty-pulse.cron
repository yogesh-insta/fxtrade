# NiftyPulse daily NSE scan — standalone scanner (no trading bots, no OANDA orders).
# Installed to /etc/cron.d/nifty-pulse by .github/workflows/deploy.yml.
# Cron (not a systemd timer) because this host's systemd (249) lacks Timer Timezone=.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# 18:00 Australia/Sydney, Sun–Fri (CRON_TZ handles AEST/AEDT on this host).
CRON_TZ=Australia/Sydney
0 18 * * 0-5 root /bin/systemctl start nifty-pulse.service
