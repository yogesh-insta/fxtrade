[Unit]
Description=AFLPulse T-30 pregame scanner (Gemini + Google Search)
Documentation=file:///opt/fxtrade/deploy/gcp/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=fxtrade
Group=fxtrade
WorkingDirectory=/opt/fxtrade
EnvironmentFile=-/etc/fxtrade/fxtrade.env
ExecStart=/opt/fxtrade/bin/afl-pulse-pregame -credentials /opt/fxtrade/.credentials
StandardOutput=append:/opt/fxtrade/logs/afl-pulse-pregame.log
StandardError=append:/opt/fxtrade/logs/afl-pulse-pregame.stderr.log
