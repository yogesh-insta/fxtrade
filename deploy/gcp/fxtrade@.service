[Unit]
Description=fxtrade bot %i
Documentation=file:///opt/fxtrade/deploy/gcp/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fxtrade
Group=fxtrade
WorkingDirectory=/opt/fxtrade
EnvironmentFile=-/etc/fxtrade/fxtrade.env
EnvironmentFile=-/etc/fxtrade/fxtrade@%i.env
ExecStart=/bin/sh -c 'exec /opt/fxtrade/bin/fxtrade -credentials "$FXTRADE_CREDENTIALS" -health-addr "${FXTRADE_HEALTH_ADDR:-:8080}" -bot %i $FXTRADE_DRY_RUN'
Restart=on-failure
RestartSec=10
LimitNOFILE=65536
StandardOutput=append:/opt/fxtrade/logs/daemon-%i.stdout.log
StandardError=append:/opt/fxtrade/logs/daemon-%i.stderr.log

[Install]
WantedBy=multi-user.target
